# Meta Model API key from https://dev.meta.ai (format LLM|<id>|<secret>)
MODEL_API_KEY=

# Defaults; override only if you know why
MODEL_BASE_URL=https://api.meta.ai/v1
GUIDE_MODEL=muse-spark-1.3
# Cheaper for development, but Meta may train on the data. Never use with real users' media.
# GUIDE_MODEL=muse-spark-1.3-contributor
VERIFY_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
ASR_MODEL=muse-voice-transcribe-1.0
COMPILE_MODEL=muse-spark-1.3
# ffmpeg is used to pull the audio track out of clips for transcription
FFMPEG=ffmpeg
